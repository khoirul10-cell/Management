{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "monthlyBudget": { "type": "number", "description": "Target/budget for the month" },
        "isPremium": { "type": "boolean", "description": "Premium subscription status" },
        "isInvited": { "type": "boolean", "description": "Invited Sheets tester status" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A single income or expense record",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner of the transaction" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "amount": { "type": "number" },
        "category": { "type": "string", "description": "Transaction category" },
        "description": { "type": "string", "description": "Optional note" },
        "timestamp": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "amount", "category", "timestamp", "createdAt", "updatedAt"]
    },
    "RecurringTransaction": {
      "title": "RecurringTransaction",
      "description": "A scheduled templates for repeating income or expense",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "interval": { "type": "string", "enum": ["daily", "weekly", "monthly", "yearly"] },
        "walletSource": { "type": "string" },
        "startDate": { "type": "string", "format": "date-time" },
        "lastTriggeredDate": { "type": "string", "format": "date-time" },
        "nextTriggeredDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "paused"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "amount", "category", "interval", "startDate", "nextTriggeredDate", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user settings and budget."
    },
    "users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Stores individual transactions for the user"
    },
    "users/{userId}/recurring_templates/{templateId}": {
      "schema": { "$ref": "#/entities/RecurringTransaction" },
      "description": "Stores recurring/repeating transaction schedules"
    },
    "users/{userId}/debts/{debtId}": {
      "schema": "object",
      "description": "Stores individual debts or loans for the user"
    },
    "users/{userId}/investments/{investmentId}": {
      "schema": "object",
      "description": "Stores user investment portfolio entries"
    },
    "users/{userId}/priceAlerts/{alertId}": {
      "schema": "object",
      "description": "Stores user price alerts for global market tickers"
    },
    "premium_emails/{email}": {
      "schema": {
        "type": "object",
        "properties": {
          "email": { "type": "string" },
          "grantedBy": { "type": "string" },
          "grantedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["email", "grantedBy"]
      },
      "description": "Premium email access mapping written by Admin"
    },
    "premium_requests/{email}": {
      "schema": {
        "type": "object",
        "properties": {
          "email": { "type": "string" },
          "displayName": { "type": "string" },
          "requestedAt": { "type": "string", "format": "date-time" },
          "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
          "reasonText": { "type": "string" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["email", "status"]
      },
      "description": "Pending and past premium access requests sent by standard users"
    }
  }
}
