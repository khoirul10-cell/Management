rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email.lower() == 'ahmadkhoirulmuna136@gmail.com');
    }

    match /users/{userId}/transactions/{transactionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/recurring_templates/{templateId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/debts/{debtId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/investments/{investmentId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/priceAlerts/{alertId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /premium_emails/{email} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email != null && (request.auth.token.email.lower() == 'ahmadkhoirulmuna136@gmail.com' || request.auth.token.email.lower() == email);
    }

    match /premium_requests/{email} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /invite_codes/{codeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
